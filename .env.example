DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require"
# En Render: solo en el servicio de Postgres (Internal / External URL según corresponda).

# true = prisma db seed borra y carga datos de prueba (clubes, facilities, activities, etc.).
# false u omitida = el seed no modifica la base (recomendado en producción).
IS_TESTING=false
