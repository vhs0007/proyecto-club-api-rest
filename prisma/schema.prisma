// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model membership {
  id       Int            @default(autoincrement())
  type     membership_type @relation(fields: [membershipTypeId, clubId], references: [id, clubId])
  membershipTypeId   Int
  userId   Int
  userTypeId Int
  createdAt DateTime
  user     users          @relation(fields: [userId, clubId, userTypeId], references: [id, clubId, typeId])
  expiration DateTime
  clubId Int
  club clubs @relation(fields: [clubId], references: [id])
  @@id([id, clubId])
}

model membership_type {
  id                    Int                    @default(autoincrement())
  name                  String
  price                 Decimal                @db.Decimal(10, 2) @default(0)
  memberships           membership[]
  facilities_membership facilities_membership[]
  clubId Int
  club clubs @relation(fields: [clubId], references: [id])
  scheduled_activities_membership_types scheduled_activities_membership_types[]
  @@id([id, clubId])
}

model facilities_membership {
  id                Int           @default(autoincrement())
  facilityId        Int
  clubId Int
  club clubs @relation(fields: [clubId], references: [id])
  membershipTypeId  Int
  facility          facilities   @relation(fields: [facilityId, clubId], references: [id, clubId])
  type              membership_type @relation(fields: [membershipTypeId, clubId], references: [id, clubId])
  @@id([id, clubId])
}

model facilities {
  id                     Int                    @default(autoincrement())
  type                   String
  capacity               Int
  isActive               Boolean
  activities             activity[]
  facilities_membership  facilities_membership[]
  facility_workers facility_workers[]
  ResponsibleWorkerTypeId Int
  ResponsibleWorkerUserId Int
  user users @relation(fields: [ResponsibleWorkerUserId, clubId, ResponsibleWorkerTypeId], references: [id, clubId, typeId])
  scheduled_activities scheduled_activities[]
  clubId Int
  club clubs @relation(fields: [clubId], references: [id])
  @@id([id, clubId])
}

model facility_workers{
  id Int @default(autoincrement())
  clubId Int
  club clubs @relation(fields: [clubId], references: [id])
  facilityId Int
  facility facilities @relation(fields: [facilityId, clubId], references: [id, clubId])
  userId Int
  userTypeId Int
  user users @relation(fields: [userId, clubId, userTypeId], references: [id, clubId, typeId])
  @@id([id, facilityId, userId, clubId, userTypeId])
  @@unique([facilityId, userId, clubId, userTypeId])
}

model activity {
  id Int @default(autoincrement())
  name String
  type String
  date DateTime
  hourStart String
  hourEnd String
  userId Int
  userTypeId Int
  user     users     @relation(fields: [userId, clubId, userTypeId], references: [id, clubId, typeId])
  cost Decimal @db.Decimal(10, 2)
  facilityId Int
  facility facilities @relation(fields: [facilityId, clubId], references: [id, clubId])
  state String @db.VarChar(20) @default("PENDIENTE")
  clubId Int
  club clubs @relation(fields: [clubId], references: [id])
  @@id([id, clubId])
}

model user_type {
  id    Int     @id @default(autoincrement())
  name  String
  users users[]
}

model users {
  /*
    name: string;
  type: UserType;
  email?: string;
  password?: string;
  createdAt?: Date;
  deletedAt?: Date;
  isActive?: boolean;
  membership?: MembershipType;
  role?: MemberRole | WorkerRole;
  salary?: number;
  hoursToWorkPerDay?: number;
  startWorkAt?: Date;
  endWorkAt?: Date;
  weight?: number;
  height?: number;
  gender?: Gender;
  birthDate?: Date;
  diet?: string;
  trainingPlan?: string;
  medicalHistory?: string;
  allergies?: string;
  medications?: string;
  medicalConditions?: string;
  */

  
  id Int @default(autoincrement())
  name String
  document String
  typeId Int
  type user_type @relation(fields: [typeId], references: [id])
  email String?
  password String?
  createdAt DateTime @default(now())
  deletedAt DateTime?
  isActive Boolean
  memberships              membership[]
  activities               activity[]
  facility_workers facility_workers[]
  facilities facilities[]
  salary Decimal? @db.Decimal(10, 2)
  hoursToWorkPerDay Int?
  employmentStartDate DateTime?
  startWorkAt String?
  endWorkAt String?
  weight Decimal? @db.Decimal(10, 2)
  height Decimal? @db.Decimal(10, 2)
  gender String?
  birthDate DateTime?
  diet String?
  trainingPlan String?
  medicalHistory String?
  allergies String?
  medications String?
  medicalConditions String?
  time_entries time_entries[]
  scheduledActivityId Int?
  clubId Int 
  club clubs @relation(fields: [clubId], references: [id])
  scheduled_activities_assistant_workers scheduled_activities_assistant_workers[]
  scheduled_activities_members scheduled_activities_members[]
  @@id([id, clubId, typeId])
  @@unique([clubId, email])
  @@unique([clubId, document])
}

model time_entries {
  id Int @id @default(autoincrement())
  userId Int
  clubId Int
  userDocument String
  club clubs @relation(fields: [clubId], references: [id])
  user users @relation(fields: [userDocument, clubId], references: [document, clubId])
  clockIn DateTime
  clockOut DateTime?
}

model clubs{
  id Int @id @default(autoincrement())
  name String
  address String
  phone String
  email String
  website String
  logo String?
  isActive Boolean
  facilities facilities[]
  time_entries time_entries[]
  users users[]
  activities activity[]
  memberships membership[]
  membership_types membership_type[]
  plugins_clubs plugins_clubs[]
  numerators numerator[]
  facilities_membership facilities_membership[]
  facility_workers facility_workers[]
  scheduled_activities scheduled_activities[]
  scheduled_activities_assistant_workers scheduled_activities_assistant_workers[]
  scheduled_activities_membership_types scheduled_activities_membership_types[]
  scheduled_activities_members scheduled_activities_members[]
  working_days working_days[]
  datetime_scheduled_activities datetime_scheduled_activities[]
}

model plugins {
  id Int @id @default(autoincrement())
  name String
  description String
  plugins_clubs plugins_clubs[]
}

model plugins_clubs {
  id Int @id @default(autoincrement())
  pluginId Int
  clubId Int
  plugin plugins @relation(fields: [pluginId], references: [id])
  club clubs @relation(fields: [clubId], references: [id])
}

model numerator{
  id Int @id @default(autoincrement())
  name String
  clubId Int
  club clubs @relation(fields: [clubId], references: [id])
  value Int
}

model scheduled_activities {
  id Int  @default(autoincrement())
  clubId Int
  club clubs @relation(fields: [clubId], references: [id])
  facilityId Int
  facility facilities @relation(fields: [facilityId, clubId], references: [id, clubId])
  userId Int
  userTypeId Int
  name String @default("-")
  scheduled_activities_assistant_workers scheduled_activities_assistant_workers[]
  scheduled_activities_membership_types scheduled_activities_membership_types[]
  scheduled_activities_members scheduled_activities_members[]
  datetime_scheduled_activities datetime_scheduled_activities[]
  @@id([id, clubId])
}

model scheduled_activities_members{
  id Int @default(autoincrement())
  clubId Int
  club clubs @relation(fields: [clubId], references: [id])
  scheduledActivityId Int
  scheduled_activities scheduled_activities @relation(fields: [scheduledActivityId, clubId], references: [id, clubId])
  userId Int
  userTypeId Int
  user users @relation(fields: [userId, clubId, userTypeId], references: [id, clubId, typeId])
  @@id([id, clubId, scheduledActivityId, userId, userTypeId])
}

model scheduled_activities_assistant_workers{
  id Int @default(autoincrement())
  clubId Int
  club clubs @relation(fields: [clubId], references: [id])
  scheduledActivityId Int
  scheduled_activities scheduled_activities @relation(fields: [scheduledActivityId, clubId], references: [id, clubId])
  userId Int
  userTypeId Int
  user users @relation(fields: [userId, clubId, userTypeId], references: [id, clubId, typeId])
  @@id([id, clubId, scheduledActivityId, userId, userTypeId])
}

model scheduled_activities_membership_types{
  id Int @default(autoincrement())
  clubId Int
  club clubs @relation(fields: [clubId], references: [id])
  membershipTypeId Int
  membership_type membership_type @relation(fields: [membershipTypeId, clubId], references: [id, clubId])
  scheduledActivityId Int
  scheduled_activities scheduled_activities @relation(fields: [scheduledActivityId, clubId], references: [id, clubId])
  @@id([id, clubId, membershipTypeId, scheduledActivityId])
}

model working_days{
  id Int @default(autoincrement())
  clubId Int
  club clubs @relation(fields: [clubId], references: [id])
  dayOfWeek String
  datetime_scheduled_activities datetime_scheduled_activities[]
  @@id([id, clubId])
}

model datetime_scheduled_activities{
  id Int @default(autoincrement())
  clubId Int
  club clubs @relation(fields: [clubId], references: [id])
  scheduledActivityId Int
  scheduled_activities scheduled_activities @relation(fields: [scheduledActivityId, clubId], references: [id, clubId])
  hourStart String
  hourEnd String
  workingDayId Int
  working_day working_days @relation(fields: [workingDayId, clubId], references: [id, clubId])
  @@id([id, clubId, scheduledActivityId, hourStart, hourEnd])
}


