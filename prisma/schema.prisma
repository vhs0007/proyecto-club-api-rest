generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model membership {
  id       Int            @id @default(autoincrement())
  type     membership_type @relation(fields: [typeId], references: [id])
  typeId   Int
  userId   Int
  createdAt DateTime
  user     users          @relation(fields: [userId, clubId], references: [id, clubId])
  expiration DateTime
  clubId Int
  club clubs @relation(fields: [clubId], references: [id])
}

model membership_type {
  id                    Int                    @id @default(autoincrement())
  name                  String
  price                 Decimal                @db.Decimal(10, 2) @default(0)
  memberships           membership[]
  facilities_membership facilities_membership[]
  clubId Int
  club clubs @relation(fields: [clubId], references: [id])
}

model facilities_membership {
  id                Int           @id @default(autoincrement())
  facilityId        Int
  membershipTypeId  Int
  facility          facilities   @relation(fields: [facilityId], references: [id])
  type              membership_type @relation(fields: [membershipTypeId], references: [id])
}

model facilities {
  id                     Int                    @id @default(autoincrement())
  type                   String
  capacity               Int
  responsibleWorker      Int
  responsibleWorkerUser  users?                 @relation("FacilityResponsible", fields: [responsibleWorker, clubId], references: [id, clubId])
  assistantWorker        Int?
  assistantWorkerUser    users?                 @relation("FacilityAssistant", fields: [assistantWorker, clubId], references: [id, clubId])
  isActive               Boolean
  activities             activity[]
  facilities_membership  facilities_membership[]
  clubId Int
  club clubs @relation(fields: [clubId], references: [id])
}

model activity {
  /*
    id: number;
  name: string;
  type: string;
  dateStart: Date;
  hourStart: string;
  hourEnd: string;
  userId: number;
  cost: number;
  facility: Facility;
  isActive: boolean;
  */
  id Int @id @default(autoincrement())
  name String
  type String
  date DateTime
  hourStart String
  hourEnd String
  userId Int
  user     users     @relation(fields: [userId, clubId], references: [id, clubId])
  cost Decimal @db.Decimal(10, 2)
  facilityId Int
  facility facilities @relation(fields: [facilityId], references: [id])
  isActive Boolean
  clubId Int
  club clubs @relation(fields: [clubId], references: [id])
}

model user_type {
  id    Int     @id @default(autoincrement())
  name  String
  users users[]
}

model users {
  /*
    name: string;
  type: UserType;
  email?: string;
  password?: string;
  createdAt?: Date;
  deletedAt?: Date;
  isActive?: boolean;
  membership?: MembershipType;
  role?: MemberRole | WorkerRole;
  salary?: number;
  hoursToWorkPerDay?: number;
  startWorkAt?: Date;
  endWorkAt?: Date;
  weight?: number;
  height?: number;
  gender?: Gender;
  birthDate?: Date;
  diet?: string;
  trainingPlan?: string;
  medicalHistory?: string;
  allergies?: string;
  medications?: string;
  medicalConditions?: string;
  */

  
  id Int @default(autoincrement())
  name String
  document String @unique
  typeId Int
  type user_type @relation(fields: [typeId], references: [id])
  email String?
  password String?
  createdAt DateTime @default(now())
  deletedAt DateTime?
  isActive Boolean
  memberships              membership[]
  activities               activity[]
  facilitiesAsResponsible  facilities[] @relation("FacilityResponsible")
  facilitiesAsAssistant    facilities[] @relation("FacilityAssistant")
  salary Decimal? @db.Decimal(10, 2)
  hoursToWorkPerDay Int?
  employmentStartDate DateTime?
  startWorkAt String?
  endWorkAt String?
  weight Decimal? @db.Decimal(10, 2)
  height Decimal? @db.Decimal(10, 2)
  gender String?
  birthDate DateTime?
  diet String?
  trainingPlan String?
  medicalHistory String?
  allergies String?
  medications String?
  medicalConditions String?
  time_entries time_entries[]
  clubId Int 
  club clubs @relation(fields: [clubId], references: [id])
  @@id([id, clubId])
}

model time_entries {
  id Int @id @default(autoincrement())
  userId Int
  clubId Int
  userDocument String
  club clubs @relation(fields: [clubId], references: [id])
  user users @relation(fields: [userDocument], references: [document])
  clockIn DateTime
  clockOut DateTime?
}

model clubs{
  id Int @id @default(autoincrement())
  name String
  address String
  phone String
  email String
  website String
  logo String?
  isActive Boolean
  facilities facilities[]
  time_entries time_entries[]
  users users[]
  activities activity[]
  memberships membership[]
  membership_types membership_type[]
  plugins_clubs plugins_clubs[]
  numerators numerator[]
}

model plugins {
  id Int @id @default(autoincrement())
  name String
  description String
  plugins_clubs plugins_clubs[]
}

model plugins_clubs {
  id Int @id @default(autoincrement())
  pluginId Int
  clubId Int
  plugin plugins @relation(fields: [pluginId], references: [id])
  club clubs @relation(fields: [clubId], references: [id])
}

model numerator{
  id Int @id @default(autoincrement())
  name String
  clubId Int
  club clubs @relation(fields: [clubId], references: [id])
  value Int
}